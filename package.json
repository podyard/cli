{
  "name": "@podyard/cli",
  "version": "0.1.1",
  "description": "Podyard CLI — manage pods, snapshots, templates, keys, and usage from the terminal",
  "keywords": [
    "podyard",
    "cli",
    "sandbox",
    "compute",
    "pods",
    "snapshots",
    "templates",
    "serverless",
    "faas"
  ],
  "homepage": "https://podyard.dev",
  "bugs": {
    "url": "https://github.com/podyard/cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/podyard/cli.git"
  },
  "license": "Apache-2.0",
  "author": "Podyard <eng@podyard.dev>",
  "type": "module",
  "bin": {
    "podyard": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "git clean -xdf dist .turbo node_modules",
    "dev": "tsup --watch",
    "format": "biome check --write .",
    "lint": "biome check .",
    "lint:commit": "node scripts/lint-commit.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@podyard/sdk": "^0.2.1",
    "@t3-oss/env-core": "^0.13.11",
    "commander": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^25.3.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "ultracite": "^8.2.1",
    "vitest": "^4.0.15"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
